<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cadmus：编码工具插件（ITool）。插件只允许依赖 Daedalus.Abstractions（规范 §8）。 -->
  <PropertyGroup>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Daedalus.Abstractions\Daedalus.Abstractions.csproj" />
  </ItemGroup>

  <!-- 生成后事件（架构 §5.3）：产物拷贝到 App 输出目录 plugins/。
       无插件私有依赖，只需部署插件自身的 dll/pdb/deps.json
       （Serilog 与 Abstractions 属宿主共享程序集，不部署）。 -->
  <PropertyGroup>
    <AppPluginsDir>$(MSBuildProjectDirectory)\..\..\src\Daedalus.App\bin\$(Configuration)\$(TargetFramework)\plugins\</AppPluginsDir>
  </PropertyGroup>
  <Target Name="DeployPlugin" AfterTargets="Build">
    <ItemGroup>
      <PluginArtifacts Include="$(TargetPath)" />
      <PluginArtifacts Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
      <!-- deps.json 让 AssemblyDependencyResolver 在部署目录能走严格解析路径 -->
      <PluginArtifacts Include="$(TargetDir)$(TargetName).deps.json" Condition="Exists('$(TargetDir)$(TargetName).deps.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginArtifacts)" DestinationFolder="$(AppPluginsDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
