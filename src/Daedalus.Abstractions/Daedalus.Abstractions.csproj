<Project Sdk="Microsoft.NET.Sdk">

  <!-- 契约程序集：ITool / IFormatter / IToolHost（架构 §4）。
       契约含 System.Windows.Forms.Control，故需 UseWindowsForms；
       第三方依赖：Serilog（架构 §6.3）与 Microsoft.Extensions.DependencyInjection.Abstractions
       （ITool 的 RegisterServices/CreateView 签名所用，step 14 经用户批准；
       该程序集列入插件加载上下文 SharedAssemblies 保证宿主与插件间类型同一性）。 -->
  <PropertyGroup>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Serilog" />
  </ItemGroup>

</Project>
