<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinForms 主程序（exe）：极薄外壳，窗口 + 插件加载 + 宿主服务（架构 §6）。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 应用图标（assets/New-AppIcon.ps1 生成）；.NET 5+ 窗口标题栏默认使用 exe 图标，无需逐窗体设置 -->
    <ApplicationIcon>daedalus.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 组合根直接配置 Serilog 滚动文件管道（NFR-001） -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <!-- 每工具独立 ServiceProvider 的实现（step 14 经用户批准；Hosting 不引用，容器构建在 App 组合根） -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Daedalus.Abstractions\Daedalus.Abstractions.csproj" />
    <ProjectReference Include="..\Daedalus.Hosting\Daedalus.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 日志配置的解析/保存逻辑（LoggingBootstrap）为 internal，向测试工程开放 -->
    <InternalsVisibleTo Include="Daedalus.App.Tests" />
  </ItemGroup>

</Project>
