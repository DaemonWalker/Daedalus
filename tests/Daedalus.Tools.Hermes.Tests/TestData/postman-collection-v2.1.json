{
  "info": {
    "_postman_id": "9f8e7d6c-0000-4000-8000-000000000001",
    "name": "示例 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "用户",
      "item": [
        {
          "name": "登录",
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": ["console.log('pre');"] }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.environment.set('token', json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Debug", "value": "1", "disabled": true }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"user\":\"a\",\"pwd\":\"b\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{host}}/api/login",
              "host": ["{{host}}"],
              "path": ["api", "login"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "查询订单",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{host}}/api/orders/:id",
          "host": ["{{host}}"],
          "path": ["api", "orders", ":id"],
          "variable": [{ "key": "id", "value": "42" }]
        }
      }
    },
    {
      "name": "表单提交",
      "request": {
        "method": "POST",
        "url": "http://example.com/form",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "a", "value": "1" },
            { "key": "b", "value": "2", "disabled": true }
          ]
        }
      }
    },
    {
      "name": "上传",
      "request": {
        "method": "POST",
        "url": "http://example.com/upload",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "x" }] },
        "body": {
          "mode": "formdata",
          "formdata": [{ "key": "file", "type": "file", "src": "/tmp/a.png" }]
        }
      }
    }
  ],
  "auth": { "type": "noauth" },
  "variable": [{ "key": "base", "value": "x" }]
}
